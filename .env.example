# ExcaliAI — Environment Variables
# Copy this file to .env and fill in your values. At least one LLM provider is
# required for real lessons; with none, the server runs a clearly-labelled demo.
# Never put real keys in this file — it is committed. Real keys go in .env (gitignored).

# ── AI routing ────────────────────────────────────────
# Providers are tried in this order; unconfigured ones are skipped. Retryable failures
# (429/quota/5xx/timeout/network) fall through to the next; providers out of quota are
# put in a cool-down until their reset. Optional per-task overrides:
# AI_PLANNER_ORDER (intent + explanation) and AI_DESIGNER_ORDER (diagram design).
AI_PROVIDER_ORDER=mistral,groq,openrouter,gemini,ollama
# Development: AI_PROVIDER_ORDER=fixtures replays canned lessons (no AI quota). Ask e.g. "fixture: number_line".
# Keys: number_line inequality supply_demand parabola trig triangle circle bar_chart line_chart pie_chart
#       punnett truth_table venn2 venn3 water_cycle ww1_timeline history_eras
# AI_PLANNER_ORDER=
# AI_DESIGNER_ORDER=
# Show provider/model in the browser debug panel (open the app with ?debug). Default: on in development.
# AI_EXPOSE_META=true

# ── Mistral (La Plateforme: console.mistral.ai → API keys) ──
MISTRAL_API_KEY=
MISTRAL_PLANNER_MODEL=mistral-small-latest
MISTRAL_DESIGNER_MODEL=mistral-medium-latest

# ── OpenRouter (free models only unless OPENROUTER_ALLOW_PAID=true) ──
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Only ids ending in ":free" are accepted by default.
OPENROUTER_PLANNER_MODELS=dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_DESIGNER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free
OPENROUTER_ALLOW_PAID=false

# ── Google AI Studio (Gemini) ──
GEMINI_API_KEY=
GEMINI_PLANNER_MODEL=gemini-3-flash-preview
GEMINI_CREATOR_MODEL=gemini-3-flash-preview   # a Pro model needs paid quota

# ── Groq ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Ollama (local, optional) ──
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PLANNER_MODEL=llama3
OLLAMA_CREATOR_MODEL=qwen2.5-coder

# Per-attempt timeouts (ms)
LLM_PLANNER_TIMEOUT_MS=90000
LLM_DESIGNER_TIMEOUT_MS=90000

# ── Persistence ───────────────────────────────────────
# ── Sketching (structures without a built-in template) ──
# Your own labelled SVGs go in apps/server/resources/sketches/ (see the README there).
# SKETCH_DIR=./apps/server/resources/sketches
# Search Wikimedia Commons for freely licensed labelled diagrams (attribution is drawn on the board).
# SKETCH_ONLINE=true
# SKETCH_ALLOW_HOSTS=commons.wikimedia.org,upload.wikimedia.org
# Fall back to an AI sketch from simple shapes when no reference diagram is found (uses one designer call).
# SKETCH_FREEHAND=true

# PostgreSQL is used when reachable; otherwise lessons are stored as JSON files in DATA_DIR.
DATABASE_URL=postgresql://excaliai:excaliai@localhost:5432/excaliai
# DATA_DIR=./apps/server/.data

# ── Server ────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Frontend ──────────────────────────────────────────
# Optional (read from apps/web/.env). Leave unset to use the Vite dev proxy (/api → :3001).
# VITE_API_URL=http://localhost:3001
