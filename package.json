{
  "name": "excaliai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:server": "npm run db:generate && turbo run build --filter=@excaliai/server...",
    "build:web": "turbo run build --filter=@excaliai/web",
    "start": "npm run start -w apps/server",
    "start:server": "npm run start -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "dev:all": "turbo run dev --filter=@excaliai/web --filter=@excaliai/server",
    "db:push": "npm run db:push -w apps/server",
    "db:generate": "npm run db:generate -w apps/server",
    "db:studio": "npm run db:studio -w apps/server"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
