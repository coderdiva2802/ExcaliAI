    "@prisma/client": "^6.2.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.2.0",
    "nanoid": "^5.0.0",
    "openchemlib": "^9.25.1",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.2.0",
    "typescript": "^5.7.0"
